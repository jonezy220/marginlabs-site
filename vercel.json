    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.marginlabs.io" }],
      "destination": "https://marginlabs.io/:path*",
      "permanent": true
    },
    {
      "source": "/execution-playbook",
      "destination": "/advisory",
      "permanent": false
    },
    {
      "source": "/the-lab/isv-referral-vs-payfac-lite",
      "destination": "/the-lab/payfac-vs-isv",
      "permanent": true
    },
    {
      "source": "/go/roadmap",
      "destination": "https://marginlabs.io/the-lab/embedded-payments-implementation-roadmap?utm_source=linkedin&utm_medium=social&utm_content=personal&utm_campaign=implementation-roadmap",
      "permanent": false
    },
    {
      "source": "/go/kyb",
      "destination": "https://marginlabs.io/the-lab/merchant-underwriting-kyb?utm_source=linkedin&utm_medium=social&utm_content=company&utm_campaign=merchant-underwriting-kyb",
      "permanent": false
    },
    {
      "source": "/go/billing",
      "destination": "https://marginlabs.io/the-lab/recurring-billing-and-the-payments-stack?utm_source=linkedin&utm_medium=social&utm_content=company&utm_campaign=recurring-billing",
      "permanent": false
    },
    {
      "source": "/go/choose",
